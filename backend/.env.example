# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Render production: set PERSISTENCE_MODE=mongo and provide MongoDB Atlas MONGO_URI.
PERSISTENCE_MODE=memory
# Render web services do not provide Docker-in-Docker by default. Use local for
# the preview fallback, or deploy the Docker executor separately for isolation.
EXECUTION_MODE=local
# Required only when EXECUTION_MODE=local; never enable this on a public
# production service unless the host is isolated and trusted.
ALLOW_UNSANDBOXED_EXECUTION=false

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/online_compiler

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# ---------- AI mentor (Explain / Find bug / Hint) ----------
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
MENTOR_TIMEOUT_MS=20000

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://apoorv965.github.io

# ---------- Code execution limits ----------
EXECUTION_TIMEOUT_MS=10000
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5
EXECUTION_PIDS_LIMIT=64
MAX_CODE_LENGTH=20000
MAX_INPUT_LENGTH=5000
MAX_OUTPUT_LENGTH=20000

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
EXECUTE_RATE_LIMIT_MAX=10
MENTOR_RATE_LIMIT_MAX=15
SUBMIT_RATE_LIMIT_MAX=10

# ---------- Docker images used for sandboxed execution ----------
DOCKER_PYTHON_IMAGE=online-compiler-python:latest
DOCKER_CPP_IMAGE=online-compiler-cpp:latest
DOCKER_JAVA_IMAGE=online-compiler-java:latest
